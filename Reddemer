local getupvalues = (debug and debug.getupvalues) or getupvalues
local getconns = getconnections or (debug and debug.getconnections)
local setupv = (debug and debug.setupvalue) or setupvalue

local function isOurGui(instance)
    local p = instance
    for _ = 1, 12 do
        if not p then break end
        if p.Name == "SalemsAutoRedeemerUI" then return true end
        p = p.Parent
    end
    return false
end

local function isVisibleChain(inst)
    local current = inst
    while current do
        if current:IsA("GuiObject") and not current.Visible then return false end
        if current:IsA("ScreenGui") then return current.Enabled end
        current = current.Parent
    end
    return true
end

local function findAllTextBoxes(pg)
    local boxes = {}
    for _, gui in ipairs(pg:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled and not isOurGui(gui) then
            for _, d in ipairs(gui:GetDescendants()) do
                if d:IsA("TextBox") and not isOurGui(d) then boxes[#boxes + 1] = d end
            end
        end
    end
    return boxes
end

local function findCodeButtons(pg)
    local btns = {}
    for _, gui in ipairs(pg:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled and not isOurGui(gui) then
            for _, d in ipairs(gui:GetDescendants()) do
                if (d:IsA("TextButton") or d:IsA("ImageButton")) and not isOurGui(d) then
                    local n = d.Name:lower()
                    local pn = (d.Parent and d.Parent.Name or ""):lower()
                    if (n:find("code") or n:find("redeem") or pn:find("code") or pn:find("redeem")) and isVisibleChain(d) then btns[#btns + 1] = d end
                end
            end
        end
    end
    return btns
end

local function clickButton(btn)
    if not btn then return false end
    local anyOk = false
    if typeof(firesignal) == "function" then anyOk = anyOk or pcall(function() firesignal(btn.MouseButton1Click) end) end
    if typeof(getconns) == "function" then
        local ok = pcall(function()
            local cc = getconns(btn.MouseButton1Click)
            if type(cc) == "table" then for _, c in ipairs(cc) do pcall(function() if c.Enabled ~= false then c:Fire() end end) end end
        end)
        anyOk = anyOk or ok
    end
    anyOk = anyOk or pcall(function() btn:Activate() end)
    return anyOk
end

local function fireBoxFocusLost(box)
    if not box then return false end
    local anyFired = false
    if typeof(firesignal) == "function" then anyFired = anyFired or pcall(firesignal, box.FocusLost, true) end
    if typeof(getconns) == "function" then
        local ok, cs = pcall(getconns, box.FocusLost)
        if ok and type(cs) == "table" then
            for _, c in ipairs(cs) do anyFired = anyFired or pcall(function() if c.Enabled ~= false then c:Fire(true) end end) end
        end
    end
    return anyFired
end

local function typeAndSubmitCode(code)
    code = tostring(code or "")
    local pg = PlayerGui
    if not pg then return false end

    local codesGui = pg:FindFirstChild("Codes")
    if codesGui then
        if codesGui:IsA("ScreenGui") then codesGui.Enabled = true end
        local codesFrame = codesGui:FindFirstChild("Codes") or codesGui
        if codesFrame then
            if codesFrame:IsA("GuiObject") then codesFrame.Visible = true end
            local cur = codesFrame
            while cur and cur ~= codesGui do if cur:IsA("GuiObject") then cur.Visible = true end; cur = cur.Parent end
            local box
            for _, d in ipairs(codesFrame:GetDescendants()) do if d:IsA("TextBox") and not isOurGui(d) then box = d; break end end
            local submitBtn
            for _, d in ipairs(codesFrame:GetDescendants()) do
                if (d:IsA("TextButton") or d:IsA("ImageButton")) and not isOurGui(d) then
                    local n = d.Name:lower()
                    if n:find("submit") or n:find("redeem") or n:find("claim") then submitBtn = d; break end
                end
            end
            if box then
                pcall(function() box.Text = code end)
                task.wait(0.05)
                if submitBtn then clickButton(submitBtn) end
                fireBoxFocusLost(box)
                return true
            end
        end
    end

    for _, btn in ipairs(findCodeButtons(pg)) do clickButton(btn); task.wait(0.05) end
    task.wait(0.2)
    local box
    local deadline = tick() + 2
    while tick() < deadline do
        local allBoxes = findAllTextBoxes(pg)
        for _, d in ipairs(allBoxes) do if isVisibleChain(d) and (d.Name:lower():find("code") or d.Name:lower():find("input")) then box = d; break end end
        if box then break end
        task.wait(0.1)
    end
    if not box then return false end
    pcall(function() box.Text = code end)
    task.wait(0.05)
    local redeemBtn
    local p = box.Parent
    for _ = 1, 8 do
        if not p then break end
        for _, d in ipairs(p:GetDescendants()) do
            if (d:IsA("TextButton") or d:IsA("ImageButton")) and not isOurGui(d) and d ~= box then
                local txt = ""
                pcall(function() txt = d.Text:lower() end)
                if d.Name:lower():find("submit") or txt:find("submit") or d.Name:lower():find("redeem") then redeemBtn = d; break end
            end
        end
        if redeemBtn then break end
        p = p.Parent
    end
    if redeemBtn then clickButton(redeemBtn) end
    fireBoxFocusLost(box)
    return true
end

