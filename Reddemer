local function attemptCodeAsync(rawCode)
    if rawCode == "" then return end
    task.spawn(function()
        local candidate = rawCode
        if state.autoRiddle then candidate = solveRiddle(candidate) end
        state.attempts += 1
        RiddleBox.Text = candidate
        local copied = copyToClipboard(candidate)
        if copied then addLog("✅ Copiado: " .. candidate, Color3.fromRGB(50, 200, 50))
        else addLog("⚠️ No copiado. Respuesta: " .. candidate, Color3.fromRGB(255, 200, 50)) end
        addLog("Enviando a Roblox...", Color3.fromRGB(92, 181, 255))
        typeAndSubmitCode(candidate)
    end)
end

local function handleServerMessage(message)
    local raw = tostring(message or "")
    addLog("Msg: " .. raw, Color3.fromRGB(150, 150, 150))
    if isCaptureTrigger(raw) then
        local extractedCode = parseTriggerMessage(raw)
        state.bufferedParts = {}
        state.bufferedCount = 0
        state.captureArmed = true
        if extractedCode and #extractedCode > 0 then
            addLog("¡Código en el mismo msj: " .. extractedCode .. "!", Color3.fromRGB(92, 181, 255))
            table.insert(state.bufferedParts, extractedCode)
            state.bufferedCount = 1
            if state.bufferedCount >= state.threshold then
                local completed = table.concat(state.bufferedParts, "")
                state.bufferedParts = {}
                state.bufferedCount = 0
                state.captureArmed = false
                attemptCodeAsync(completed)
            end
        else
            addLog("Trigger detectado. Esperando fragmentos...", Color3.fromRGB(92, 181, 255))
        end
        return
    end
    if not state.captureArmed then return end
    table.insert(state.bufferedParts, raw)
    state.bufferedCount = #state.bufferedParts
    addLog("Atrapado ("..state.bufferedCount.."/"..state.threshold..")", Color3.fromRGB(255, 255, 255))
    if state.bufferedCount >= state.threshold then
        local completed = table.concat(state.bufferedParts, "")
        state.bufferedParts = {}
        state.bufferedCount = 0
        state.captureArmed = false
        attemptCodeAsync(completed)
    end
end

local function onRemoteEvent(...)
    if not state.sniping then return end
    local args = table.pack(...)
    local first, second, third, fourth = args[1], args[2], args[3], args[4]
    if typeof(first) ~= "string" or typeof(second) ~= "number" or typeof(third) ~= "string" then return end
    local accepted = third:match("Sounds") ~= nil
    if not accepted and typeof(fourth) == "string" then accepted = (fourth == "Top" or fourth == "Bottom") end
    if not accepted then return end
    handleServerMessage(first)
end

local remoteConnections = {}
local function attachRemoteEvent(object)
    if not object:IsA("RemoteEvent") or remoteConnections[object] then return end
    local ok, connection = pcall(function() return object.OnClientEvent:Connect(onRemoteEvent) end)
    if ok and connection then remoteConnections[object] = connection end
end

for _, object in ipairs(ReplicatedStorage:GetDescendants()) do attachRemoteEvent(object) end
ReplicatedStorage.DescendantAdded:Connect(attachRemoteEvent)

