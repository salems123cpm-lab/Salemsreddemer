-- ==========================================
local function isCaptureTrigger(msg)
    local text = msg:lower():gsub("^%s+", ""):gsub("%s+$", "")
    if text:find("invalid", 1, true) or text:find("redeemed", 1, true) or text:find("expired", 1, true) 
        or text:find("used", 1, true) or text:find("sold out", 1, true) or text:find("inválido", 1, true) 
        or text:find("canjeado", 1, true) then return false end

    local phrases = {
        "use code", "usecode", "use the code", "use this code", "use a code",
        "uses code", "using code", "used code",
        "usa el código", "usa el codigo", "usa codigo", "usa código", 
        "usa este codigo", "usa este código", "usar codigo", "usar código",
        "code is", "code's", "codes are", "codes is", 
        "código es", "codigo es", "el código es", "el codigo es",
        "new code", "new code is", "nuevo código", "nuevo codigo", 
        "free code", "código gratis", "codigo gratis",
        "secret code", "código secreto", "codigo secreto",
        "drop code", "code drop", "code release", "code released",
        "here is the code", "here's the code", "aquí está el código", "aqui esta el codigo",
        "type code", "type the code", "enter code", "enter the code", 
        "escribe el código", "escribe el codigo", "pon el código", "pon el codigo",
        "redeem code", "claim code", "gift code", "reward code", "special code",
        "canjea", "canjear", "reclama", "reclamar", "regalo", "premio",
        "code:", "codigo:", "código:",
        "riddle is", "riddle:", "the riddle", "new riddle", "riddle -",
        "acertijo es", "acertijo:", "el acertijo", "nuevo acertijo",
        "answer is", "answer:", "the answer", "respuesta es", "respuesta:"
    }
    for _, phrase in ipairs(phrases) do
        if text:find(phrase, 1, true) then return true end
    end
    return false
end

local function parseTriggerMessage(msg)
    local text = msg:gsub("%s+$", ""):gsub("%.+$", ""):gsub("…+$", ""):gsub("%-+$", "")
    local lower = text:lower()
    
    local triggers = {
        "use this code", "use the code", "use a code", "use code",
        "usa este codigo", "usa este código", "usa el codigo", "usa el código", 
        "usa codigo", "usa código", "usar codigo", "usar código",
        "the code is", "code is", "new code is", "new code",
        "free code is", "free code", "secret code is", "secret code",
        "here is the code", "here's the code",
        "enter code", "enter the code", "type code", "type the code",
        "escribe el código", "escribe el codigo", "pon el código", "pon el codigo",
        "redeem code", "claim code", "gift code", "reward code", "special code",
        "canjea", "canjear", "reclama", "reclamar",
        "drop code", "code drop", "code release", "code released",
        "código es", "codigo es", "el código es", "el codigo es",
        "nuevo código es", "nuevo codigo es", "nuevo código", "nuevo codigo",
        "código gratis", "codigo gratis", "código secreto", "codigo secreto",
        "the riddle is", "riddle is", "new riddle",
        "el acertijo es", "acertijo es", "nuevo acertijo",
        "the answer is", "answer is", "answer:",
        "la respuesta es", "respuesta es", "respuesta:",
        "code:", "code-", "code=", "codigo:", "codigo-", "codigo=", "código:", "código-", "código=",
        "riddle:", "acertijo:",
    }
    
    for _, trigger in ipairs(triggers) do
        local start_idx = lower:find(trigger, 1, true)
        if start_idx then
            local after = text:sub(start_idx + #trigger)
            local code_start = nil
            for i = 1, #after do
                local c = after:sub(i, i)
                if c:match("[%w_]") then
                    code_start = i
                    break
                end
            end
            if not code_start then return nil end
            local code_part = after:sub(code_start)
            code_part = code_part:gsub("[^%w_]+$", "")
            if code_part == "" then return nil end
            return code_part
        end
    end
    return nil
end

