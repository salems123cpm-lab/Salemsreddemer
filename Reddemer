local function loadBackground(index)
    if BgCache[index] then return BgCache[index] end
    local url = BackgroundURLs[index]
    if not url then return nil end
    local fileName = "salems_bg_" .. index .. ".jpg"
    
    local loader = getcustomasset or getsynasset
    if not loader or not writefile then return nil end

    local success, img = pcall(function()
        if not isfile(fileName) then
            local body = game:HttpGet(url)
            writefile(fileName, body)
        end
        return loader(fileName)
    end)
    
    if success and img then
        BgCache[index] = img
        return img
    end
    return nil
end

